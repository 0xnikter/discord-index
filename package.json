{
  "name": "discord-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Searchable Discord index served over MCP: fetch -> SQLite FTS5 + embeddings -> MCP tools.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "discord-index": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "sync": "node dist/cli.js sync",
    "serve": "node dist/cli.js serve",
    "status": "node dist/cli.js status",
    "search": "node dist/cli.js search",
    "smoke": "node scripts/smoke.mjs",
    "fixture": "node scripts/fixture.mjs ./fixture",
    "deploy:remote": "bash scripts/install-remote.sh",
    "seed": "node scripts/fixture.mjs ./fixture && node dist/cli.js sync --seed ./fixture",
    "test": "pnpm build && node --test dist/__tests__/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^5.4.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "volta": {
    "node": "24.20.0"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}