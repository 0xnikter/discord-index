# ─── Discord ──────────────────────────────────────────────────────────────────
# Bot token. Grant the bot View Channels + Read Message History ONLY, and enable
# the Message Content intent (Developer Portal -> Bot -> Privileged Gateway
# Intents). Without that intent Discord returns history with empty content.
DISCORD_TOKEN=
# Server id: enable Developer Mode in Discord, right-click the server, Copy ID.
DISCORD_GUILD_ID=

# ─── Embeddings (optional) ────────────────────────────────────────────────────
# Enables semantic search. MESSAGE TEXT IS SENT TO OPENAI to be embedded.
# Leave empty to keep every message on your own hardware: search stays
# keyword-only and says so in each result.
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small

# ─── Access control ───────────────────────────────────────────────────────────
# Single full-access token for the HTTP transport. Generate: openssl rand -hex 32
# The server REFUSES TO START over HTTP without a token. stdio needs none.
MCP_AUTH_TOKEN=

# Path to a policy file for tiers, roles and exclusions. Without it, the single
# token above grants everything. See policy.example.yaml.
POLICY_FILE=
# Only for Docker: host path bind-mounted to /app/policy.yaml. Keep the policy
# OUTSIDE the source tree so a code update cannot overwrite it.
POLICY_HOST_PATH=

# One variable per role named in the policy file's tokenEnv fields:
# MCP_TOKEN_TEAM=
# MCP_TOKEN_LEADERSHIP=

# Env overrides for the policy's exclude block, comma separated. Ids or names.
EXCLUDE_CATEGORIES=
EXCLUDE_CHANNELS=

# ─── Serving ──────────────────────────────────────────────────────────────────
# Caddy's site address. A hostname gets automatic HTTPS; ":80" is PLAIN HTTP and
# will send your bearer token in cleartext. Set this to your domain.
SITE_ADDRESS=
HTTP_HOST=127.0.0.1
HTTP_PORT=8087
# Trust X-Forwarded-For for rate limiting and lockout. Only enable when a proxy
# is the sole route in; the header is client-supplied and otherwise forgeable.
TRUST_PROXY=false
# Persist the per-call audit log to a file, in addition to stderr.
AUDIT_LOG_PATH=

# ─── Indexing ─────────────────────────────────────────────────────────────────
DB_PATH=./data/index.db
# None | Active | All. "All" also lists archived threads, at one extra request
# per parent channel per run, for content that never changes.
INCLUDE_THREADS=Active
# Every channel shares ONE Discord rate-limit bucket, measured at 5 requests/s.
# That is a hard ceiling concurrency cannot beat; stay just under it.
DISCORD_REQUESTS_PER_SECOND=4
FETCH_CONCURRENCY=6
# Seconds between sync runs, measured from the END of the previous run, so runs
# never overlap. A full incremental pass is ~1 request per channel.
SYNC_INTERVAL_SECONDS=300
SYNC_OVERLAP_MINUTES=15
# Conversation windows break on this much silence, or 50 messages / 4000 chars.
WINDOW_GAP_MINUTES=240
# Search results warn when the index is further behind than this.
STALE_AFTER_MINUTES=60
