# Discord bot token. Grant the bot View Channels + Read Message History ONLY.
DISCORD_TOKEN=
# Guild (server) id to index.
DISCORD_GUILD_ID=

# Embeddings (hybrid search). Omit to run keyword-only.
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Paths (defaults are fine)
DB_PATH=./data/index.db

# Sync window: re-export this many minutes of overlap each run (idempotent upserts).
SYNC_OVERLAP_MINUTES=15
# Threads: None | Active | All. "All" also lists archived threads, at one extra request per parent
# channel per run, for content that never changes - use it for a one-off backfill, then switch back.
INCLUDE_THREADS=Active
# Channels fetched concurrently. Hides per-request latency; it cannot raise the shared bucket ceiling.
FETCH_CONCURRENCY=6
# All channels share ONE Discord rate-limit bucket (measured: 5 requests / 1s). That is a hard
# ceiling concurrency cannot beat, so staying just under it avoids 429s entirely.
DISCORD_REQUESTS_PER_SECOND=4
FETCH_CONCURRENCY=6
# Seconds between sync runs, measured from the END of the previous run - runs never overlap.
# A full incremental pass is ~90s at the rate above, so 300 is a comfortable floor.
SYNC_INTERVAL_SECONDS=300
# Search results are flagged stale when the newest channel sync is older than this.
STALE_AFTER_MINUTES=60

# HTTP transport (serve --transport http). Required: the server refuses to serve HTTP without it.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
HTTP_HOST=127.0.0.1
HTTP_PORT=8087
