[Unit]
Description=discord-index MCP server (HTTP, loopback only)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/discord-index
ExecStart=/usr/bin/env node dist/cli.js serve --transport http
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
